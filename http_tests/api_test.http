### ═══════════════════════════════════════════════════════════
### 14. 圖片上傳
### ═══════════════════════════════════════════════════════════
#
# 需要一個真的檔案。把任意圖片放到 http_tests/fixtures/sample.png 再跑。

# @no-log
POST {{apiBase}}/api/uploads
Authorization: Bearer {{idToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="sample.png"
Content-Type: image/png

< ./fixtures/sample.png
--WebAppBoundary--

> {%
    client.test("回 200", function() {
        client.assert(response.status === 200, "得到 " + response.status);
    });

    const r = response.body;

    client.test("回的是站台路徑不是 GCS 網址", function() {
        client.assert(typeof r.path === "string", "少了 path 欄位");
        client.assert(r.path.indexOf("/images/") === 0,
            "path 要以 /images/ 開頭，得到 " + r.path);
        client.assert(r.path.indexOf("storage.googleapis.com") < 0,
            "不可以回 GCS 絕對網址——bucket 是私有的，而且那會把儲存供應商寫死進文章內容");
        client.assert(r.url === undefined,
            "契約裡沒有 url 欄位，只有 path");
    });

    client.test("有尺寸", function() {
        client.assert(typeof r.width === "number" && r.width > 0, "少了 width");
        client.assert(typeof r.height === "number" && r.height > 0, "少了 height");
        client.assert(r.width <= 1600,
            "長邊應該被縮到 1600 以內，得到 " + r.width);
    });

    client.global.set("uploadedPath", r.path);
%}


### ═══════════════════════════════════════════════════════════
### 15. 讀取圖片（公開路由，不帶 token）
### ═══════════════════════════════════════════════════════════
# @no-log
GET {{apiBase}}{{uploadedPath}}

> {%
    client.test("匿名就能讀", function() {
        client.assert(response.status === 200,
            "得到 " + response.status + "。這是公開路由，讀者的瀏覽器不會帶 token");
    });

    client.test("快取標頭設對了", function() {
        const cc = response.headers.valueOf("Cache-Control") || "";
        client.assert(cc.indexOf("immutable") >= 0,
            "檔名帶 UUID、內容永不改變，應該設 immutable。得到：" + cc);
        client.assert(cc.indexOf("max-age=31536000") >= 0,
            "應該快取一年。得到：" + cc);
    });

    client.test("有 ETag", function() {
        client.assert(response.headers.valueOf("ETag") !== null,
            "需要 ETag 才能回 304，否則 CDN 每次 miss 都要重傳整個檔案");
    });
%}


