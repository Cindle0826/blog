## 契約② 的可執行版本
#
# docs/API.md 每個端點對應一則請求，帶斷言。你實作一個 handler 就跑一次，
# 它會直接告訴你回傳的形狀跟契約對不對——不用等前端接上去才發現不一致。
#
# ── 怎麼跑 ───────────────────────────────────────────────────
#
# 1. 右上角環境選 local（或 cloudrun）
# 2. 確認 http-client.private.env.json 裡有 idToken
#    （沒有的話：GoLand 跑「Run get-uid.html」，會自動打開瀏覽器）
# 3. 從上往下跑。第 3 則會建立一篇測試文章，後面的請求靠它串起來，
#    最後一則會刪掉。中途失敗的話重跑一次第 3 則就好。
#
# 「Run all requests in file」可以一次跑完整個流程。
#
# ── 目前預期會全部失敗 ───────────────────────────────────────
#
# cmd/server 還沒實作，所以現在跑會全部連不上。這是刻意的：這份檔案是
# 你的靶子，實作到哪就有幾則變綠。


### 1. 認證：不帶 token → 401
### ═══════════════════════════════════════════════════════════
# @no-log
GET {{apiBase}}/api/posts

> {%
    client.test("回 401 而不是 200", function() {
        client.assert(response.status === 401,
            "預期 401，得到 " + response.status + "。沒帶 token 就能讀後台是嚴重問題");
    });
    client.test("錯誤格式符合契約", function() {
        const e = response.body.error;
        client.assert(e !== undefined,
            "回應少了 error 物件。契約要的是 {\"error\":{\"code\",\"message\"}}，" +
            "實際收到：" + JSON.stringify(response.body));
        client.assert(e.code === "unauthorized", "code 應為 unauthorized，得到 " + e.code);
        client.assert(typeof e.message === "string" && e.message.length > 0,
            "message 應該是給人看的非空字串");
    });
%}


### 2. 認證：token 有效但 UID 不在白名單 → 403
### ═══════════════════════════════════════════════════════════
#
# 這則是整份檔案最重要的一則。它驗證「驗證身分」與「檢查權限」確實是
# 兩道獨立的關卡——只做第一道的話，全世界有 Google 帳號的人都能發文。
#
# 前置條件：http-client.private.env.json 的 otherUserIdToken 要填一個
# 「合法但 UID 不在 ADMIN_UIDS」的 token。
#
# 最簡單的拿法是用第二個 Google 帳號（例如公司帳號）登入 scripts/get-uid.html。
# 注意不要填成自己的 token——那樣測到的是「白名單設錯了」而不是「白名單有生效」。
#
# 還沒準備好就先跳過這則，但別忘記回來補：它是唯一能證明白名單真的生效的測試。

# @no-log
GET {{apiBase}}/api/posts
Authorization: Bearer {{otherUserIdToken}}

> {%
    client.test("非白名單使用者被擋在 403", function() {
        client.assert(response.status === 403,
            "預期 403，得到 " + response.status +
            "。如果是 200，代表白名單檢查沒生效——任何 Google 帳號都能操作後台");
    });
    client.test("code 是 forbidden 不是 unauthorized", function() {
        const code = (response.body.error || {}).code;
        client.assert(code === "forbidden",
            "401/unauthorized 是「你是誰」的問題，403/forbidden 是「你能做什麼」的問題，" +
            "兩者不該混用。得到 " + code);
    });
%}


### 3. 建立文章 → 201，且一律是 draft
### ═══════════════════════════════════════════════════════════
# @no-log
POST {{apiBase}}/api/posts
Authorization: Bearer {{idToken}}
Content-Type: application/json

{
  "title": "契約測試 {{$timestamp}}",
  "kind": "post",
  "markdown": "## 第一段\n\n這是測試內容。",
  "tagSlugs": ["go"]
}

> {%
    client.test("回 201", function() {
        client.assert(response.status === 201, "預期 201，得到 " + response.status);
    });

    const p = response.body;

    client.test("一律建成 draft", function() {
        client.assert(p.status === "draft",
            "契約寫明新文章不能直接建成已發布，得到 status=" + p.status);
        client.assert(p.publishedAt === null,
            "draft 的 publishedAt 必須是 null（不是省略、不是空字串），得到 " + JSON.stringify(p.publishedAt));
    });

    client.test("slug 已自動產生", function() {
        client.assert(typeof p.slug === "string" && p.slug.length > 0,
            "slug 留空時後端要自己生一個");
    });

    client.test("回傳完整物件（與 GET /api/posts/{id} 同形狀）", function() {
        ["id","slug","kind","status","title","summary","markdown","tagSlugs",
         "pinned","publishedAt","createdAt","updatedAt"].forEach(function(k) {
            client.assert(p[k] !== undefined, "少了欄位 " + k);
        });
    });

    client.global.set("postId", p.id);
    client.global.set("postSlug", p.slug);
    client.global.set("createdUpdatedAt", p.updatedAt);
    client.log("建立的測試文章 id=" + p.id + " slug=" + p.slug);
%}


### 4. 取單篇 → 有 markdown，沒有 html
### ═══════════════════════════════════════════════════════════
# @no-log
GET {{apiBase}}/api/posts/{{postId}}
Authorization: Bearer {{idToken}}

> {%
    client.test("回 200", function() {
        client.assert(response.status === 200, "得到 " + response.status);
    });

    const p = response.body;

    client.test("有 markdown", function() {
        client.assert(typeof p.markdown === "string", "編輯頁需要 markdown");
    });

    client.test("沒有 html", function() {
        client.assert(p.html === undefined,
            "契約寫明不回傳 html——前端自己即時預覽，後端那份對它沒用，白白增加傳輸量");
    });

    client.test("時間是 UTC 的 RFC3339 字串", function() {
        client.assert(typeof p.createdAt === "string",
            "契約要求時間一律是字串，不要回 Unix timestamp");
        client.assert(/Z$|[+-]\d{2}:\d{2}$/.test(p.createdAt),
            "createdAt 少了時區標示：" + p.createdAt);
    });
%}


### 5. 列表 → 不含全文
### ═══════════════════════════════════════════════════════════
# @no-log
# @timeout 300s
GET {{apiBase}}/api/posts?status=all&page=1&limit=10
Authorization: Bearer {{idToken}}

> {%
    client.test("回 200", function() {
        client.assert(response.status === 200, "得到 " + response.status);
    });

    client.test("外層是 items + page + totalPages + total", function() {
        const b = response.body;
        client.assert(Array.isArray(b.items), "items 必須是陣列");
        client.assert(b.page === 1, "page 應該是 1，得到 " + b.page);
        client.assert(typeof b.totalPages === "number",
            "totalPages 必須是數字——前端靠它畫頁碼列");
        client.assert(typeof b.total === "number", "total 必須是數字");
        client.assert(b.total >= b.items.length,
            "total（" + b.total + "）比這頁的筆數（" + b.items.length + "）還少。" +
            "可能是先切頁才過濾 search，或是 total 用了不同的查詢條件");
    });

    client.test("列表不夾帶 markdown / html", function() {
        response.body.items.forEach(function(p, i) {
            client.assert(p.markdown === undefined,
                "第 " + i + " 筆夾帶了 markdown。50 篇文章的全文會讓回應變成好幾 MB");
            client.assert(p.html === undefined, "第 " + i + " 筆夾帶了 html");
        });
    });

    client.test("剛建立的文章在列表裡", function() {
        const id = client.global.get("postId");
        client.assert(response.body.items.some(function(p) { return p.id === id; }),
            "找不到剛建立的 " + id);
    });
%}


### ═══════════════════════════════════════════════════════════
### 5b. 超出範圍的頁碼 → 200 + 空陣列，不是 404
### ═══════════════════════════════════════════════════════════
# @no-log
GET {{apiBase}}/api/posts?status=all&page=9999&limit=10
Authorization: Bearer {{idToken}}

> {%
    client.test("回 200", function() {
        client.assert(response.status === 200,
            "得到 " + response.status + "。「這頁沒東西」是正常結果，不是錯誤");
    });

    client.test("items 是空陣列，不是 null", function() {
        client.assert(Array.isArray(response.body.items),
            "items 是 " + JSON.stringify(response.body.items) + "。" +
            "Go 的 nil slice（var posts []Post）會被編成 null，前端 .map() 會直接炸掉");
        client.assert(response.body.items.length === 0,
            "第 9999 頁不該有東西，得到 " + response.body.items.length + " 筆");
    });
%}


### ═══════════════════════════════════════════════════════════
### 5c. 頁碼不合法 → 400
### ═══════════════════════════════════════════════════════════
# @no-log
GET {{apiBase}}/api/posts?page=0
Authorization: Bearer {{idToken}}

> {%
    client.test("回 400", function() {
        client.assert(response.status === 400,
            "得到 " + response.status + "。page 從 1 開始，0 或負數是使用者送錯，不是伺服器出事");
    });

    client.test("code 是 invalid_request", function() {
        const code = (response.body.error || {}).code;
        client.assert(code === "invalid_request", "得到 " + code);
    });
%}


### ═══════════════════════════════════════════════════════════
### 6. PATCH → 只動有送的欄位
### ═══════════════════════════════════════════════════════════
#
# 這則同時檢查 API.md 列的六個連帶動作裡，前端看得到的那幾個。
# toc / readingMin / hasCode 不在回應裡，要自己看 Firestore 確認。

# @no-log
PATCH {{apiBase}}/api/posts/{{postId}}
Authorization: Bearer {{idToken}}
Content-Type: application/json

{
  "markdown": "## 改過的第一段\n\n```go\nfmt.Println(\"hi\")\n```\n\n## 第二段\n\n多一段。"
}

> {%
    client.test("回 200 並帶回完整物件", function() {
        client.assert(response.status === 200, "得到 " + response.status);
        client.assert(response.body.id !== undefined,
            "PATCH 要回傳更新後的完整物件，前端才不用再發一次 GET");
    });

    const p = response.body;

    client.test("markdown 已更新", function() {
        client.assert(p.markdown.indexOf("改過的第一段") >= 0, "內容沒更新");
    });

    client.test("沒送的欄位維持原狀", function() {
        client.assert(p.title.indexOf("契約測試") === 0,
            "title 沒送卻被改掉了——PATCH 要用 Firestore 的 Update 不是 Set");
        client.assert(Array.isArray(p.tagSlugs) && p.tagSlugs.length === 1,
            "tagSlugs 沒送卻被清空了，同上");
    });

    client.test("updatedAt 有前進", function() {
        const before = client.global.get("createdUpdatedAt");
        client.assert(p.updatedAt !== before,
            "updatedAt 沒變。每次存檔都該更新：" + before);
    });

    client.test("仍是 draft", function() {
        client.assert(p.status === "draft", "PATCH 不應該改變發布狀態");
    });
%}


### ═══════════════════════════════════════════════════════════
### 7. 發布 → status 與 publishedAt
### ═══════════════════════════════════════════════════════════
# @no-log
POST {{apiBase}}/api/posts/{{postId}}/publish
Authorization: Bearer {{idToken}}
Content-Type: application/json

{ "publish": true }

> {%
    client.test("回 200", function() {
        client.assert(response.status === 200, "得到 " + response.status);
    });

    const p = response.body;

    client.test("變成 published 且有發布時間", function() {
        client.assert(p.status === "published", "得到 " + p.status);
        client.assert(p.publishedAt !== null && p.publishedAt !== undefined,
            "第一次發布要設定 publishedAt");
    });

    client.global.set("firstPublishedAt", p.publishedAt);
%}


### ═══════════════════════════════════════════════════════════
### 8. 退回草稿 → publishedAt 必須保持不變
### ═══════════════════════════════════════════════════════════
#
# 這是容易寫錯的一條。退回草稿時把 publishedAt 清掉的話，重新發布時
# 日期會跳成今天——一篇去年的文章突然變成新文章，sitemap 和 feed 都會亂。

# @no-log
POST {{apiBase}}/api/posts/{{postId}}/publish
Authorization: Bearer {{idToken}}
Content-Type: application/json

{ "publish": false }

> {%
    client.test("回到 draft", function() {
        client.assert(response.body.status === "draft", "得到 " + response.body.status);
    });

    client.test("publishedAt 沒有被清掉", function() {
        const before = client.global.get("firstPublishedAt");
        client.assert(response.body.publishedAt === before,
            "publishedAt 從 " + before + " 變成 " + response.body.publishedAt +
            "。退回草稿不該動它，否則重新發布時日期會跳掉");
    });
%}


### ═══════════════════════════════════════════════════════════
### 9. 找不到的文章 → 404
### ═══════════════════════════════════════════════════════════
# @no-log
GET {{apiBase}}/api/posts/definitely-not-a-real-id-xyz
Authorization: Bearer {{idToken}}

> {%
    client.test("回 404 而不是 500", function() {
        client.assert(response.status === 404,
            "得到 " + response.status + "。「找不到」是正常結果不是錯誤，" +
            "Firestore 的 NotFound 要轉成哨兵錯誤再轉成 404");
    });
    client.test("code 是 not_found", function() {
        const code = (response.body.error || {}).code;
            client.assert(code === "not_found",
                "得到 " + code);
    });
%}


### ═══════════════════════════════════════════════════════════
### 10. slug 撞號 → 409
### ═══════════════════════════════════════════════════════════
# @no-log
POST {{apiBase}}/api/posts
Authorization: Bearer {{idToken}}
Content-Type: application/json

{
  "title": "另一篇",
  "slug": "{{postSlug}}"
}

> {%
    client.test("回 409", function() {
        client.assert(response.status === 409,
            "得到 " + response.status + "。slug 必須全站唯一，撞號要明確回報，" +
            "不要默默改成別的或覆蓋既有文章");
    });
    client.test("code 是 slug_conflict", function() {
        const code = (response.body.error || {}).code;
            client.assert(code === "slug_conflict",
                "得到 " + code);
    });
%}


