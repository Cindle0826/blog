### 12. 標籤列表
### ═══════════════════════════════════════════════════════════
# @no-log
GET {{apiBase}}/api/tags
Authorization: Bearer {{idToken}}

> {%
    client.test("回 200，外層是 items", function() {
        client.assert(response.status === 200, "得到 " + response.status);
        client.assert(Array.isArray(response.body.items), "items 必須是陣列");
    });

    client.test("每筆有 slug / name / count", function() {
        response.body.items.forEach(function(t, i) {
            client.assert(typeof t.slug === "string", "第 " + i + " 筆少了 slug");
            client.assert(typeof t.name === "string", "第 " + i + " 筆少了 name");
            client.assert(typeof t.count === "number", "第 " + i + " 筆的 count 不是數字");
        });
    });
%}


