{{ define "header" }}
<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true">~/</span>
      <span class="brand__name">{{ .Site.Name }}</span>
    </a>

    <nav class="nav" aria-label="主要導覽">
      {{- range .Site.Nav }}
      <a class="nav__link" href="{{ .Href }}">{{ .Label }}</a>
      {{- end }}
    </nav>

    <div class="site-header__actions">
      <a class="icon-btn" href="/search" aria-label="搜尋">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      </a>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="切換深淺色主題">
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 019.5 4a8.5 8.5 0 1010.5 10.5z"/></svg>
      </button>
    </div>
  </div>
</header>
{{ end }}
